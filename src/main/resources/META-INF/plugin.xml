<idea-plugin>
    <id>com.example.aichat</id>
    <name>AI Chat Demo</name>
    <version>1.0.0</version>
    <vendor>Demo</vendor>
    <description>Demo AI assistant chat interface for IntelliJ IDEA</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="AI Chat"
                    anchor="right"
                    factoryClass="com.example.aichat.AiChatToolWindowFactory"
                    icon="/icons/pluginIcon.svg"/>
    </extensions>
</idea-plugin>
